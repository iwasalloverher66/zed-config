{
  "theme": "Carbonfox - blurred",
  "terminal": {
    "button": false
  },
  "git_panel": {
    "button": false
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "outline_panel": {
    "dock": "left",
    "button": false
  },
  "debugger": {
    "button": false
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false
  },
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "left"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "search": {
    "button": false
  },
  "global_lsp_settings": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "on_new_window": "empty_tab",
  "cli_default_open_behavior": "existing_window",
  "confirm_quit": true,
  "base_keymap": "VSCode",
  "title_bar": {
    "show_menus": false,
    "show_project_items": true,
    "show_worktree_name": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Warm Charmed Icons"
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 18.0,

  "cursor_shape": "bar",
  "cursor_blink": true,
  "cursor_animation": {
    "enabled": true
  },
  "multi_cursor_modifier": "cmd_or_ctrl",

  "soft_wrap": "bounded",
  "preferred_line_length": 100,
  "show_wrap_guides": false,
  "minimap": {
    "show": "never"
  },
  "sticky_scroll": {
    "enabled": true
  },
  "colorize_brackets": true,
  "gutter": {
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 2,
    "runnables": false
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true
    },
    "git_diff": false
  },
  "scroll_sensitivity": 1.1,

  "tab_size": 2,
  "hard_tabs": false,
  "auto_indent": "syntax_aware",
  "linked_edits": true,
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.organizeImports": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "allowed": true,
    "jsxSingleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "none"
  },
  "file_types": {
    "tailwindcss": ["*.css"]
  },
  "show_completions_on_input": true,
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed"
  },
  "max_tabs": 6,
  "tab_bar": {
    "show": true,
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "project_panel": {
    "dock": "left",
    "button": false,
    "default_width": 260,
    "indent_size": 15,
    "auto_fold_dirs": false
  },
  "git_panel": {
    "dock": "left"
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "terminal": {
    "font_size": 18.0,
    "cursor_shape": "bar",
    "blinking": "on",
    "default_height": 240,
    "button": false,
    "copy_on_select": true,
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "load_direnv": "shell_hook",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
